rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // JeevanPath rules for uneducated SC beneficiaries
    // Allow reading and writing users and profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{profileId} {
      allow read, write: if true;
    }
  }
}
